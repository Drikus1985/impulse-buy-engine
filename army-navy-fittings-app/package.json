{
  "name": "army-navy-fittings-app",
  "version": "1.0.0",
  "private": true,
  "description": "Installable storefront for Army Navy Fittings \u2014 AN performance plumbing, Alberton, South Africa.",
  "type": "module",
  "scripts": {
    "import": "node scripts/import-catalogue.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/finalise-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.mjs\"",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
